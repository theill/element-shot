{
  "manifest_version": 3,
  "name": "Element Shot",
  "short_name": "Element Shot",
  "description": "Pick any element on a page and save a clean screenshot of just that element on a soft background.",
  "version": "1.4.0",
  "author": "Peter Theill",
  "homepage_url": "https://theill.com",
  "minimum_chrome_version": "110",
  "permissions": ["activeTab", "scripting", "downloads", "clipboardWrite"],
  "action": {
    "default_title": "Element Shot: pick an element to screenshot"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "about.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
